---
import Layout from '../../layouts/Layout.astro';
import metaData from '../../../data/meta.json';
import { withBase } from '../../lib/url';

const dataVersion = metaData.fetchedAt;
---

<Layout
  title="動物用藥品詳情 - 動物用藥資訊"
  description="動物用藥許可證登記資訊、成份內容、適用物種與使用限制查詢。"
>
  <div id="drug-app" data-version={dataVersion}>
    <!-- 1. 骨架畫面 / 載入中狀態 (預設顯示) -->
    <div id="state-loading" style="display: flex; flex-direction: column; gap: 1.5rem;">
      <div class="card skeleton-card" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem;">
        <div class="skeleton-line" style="width: 180px; height: 24px;"></div>
        <div class="skeleton-line" style="width: 60%; height: 32px;"></div>
        <div class="skeleton-line" style="width: 40%; height: 20px;"></div>
      </div>

      <div class="card skeleton-card" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <div class="skeleton-line" style="width: 120px; height: 24px;"></div>
        <div class="skeleton-line" style="width: 100%; height: 40px;"></div>
        <div class="skeleton-line" style="width: 100%; height: 40px;"></div>
        <div class="skeleton-line" style="width: 100%; height: 40px;"></div>
      </div>

      <noscript>
        <div class="card" style="background-color: #fef2f2; border: 1px solid #f87171; padding: 1.5rem; text-align: center; color: #991b1b;">
          <p style="font-weight: 700; font-size: 1.1rem; margin-bottom: 0.5rem;">本頁面需要啟用 JavaScript</p>
          <p style="font-size: 0.9rem;">動物用藥品詳情採用即時資料讀取，請在瀏覽器設定中開啟 JavaScript 後重新整理頁面。</p>
        </div>
      </noscript>
    </div>

    <!-- 2. 查無資料狀態 (Not Found) -->
    <div id="state-not-found" class="card" style="display: none; padding: 2.5rem; text-align: center; color: #4b5563;">
      <span style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">🔍</span>
      <h2 style="font-size: 1.35rem; color: #111827; margin-bottom: 0.5rem;">找不到指定的動物用藥品</h2>
      <p style="font-size: 0.95rem; margin-bottom: 1.5rem;">
        您所查詢的許可證字號不存在、網址參數有誤，或該藥品已自資料庫移除。
      </p>
      <a href={withBase('/')} class="btn btn-primary" style="display: inline-block; padding: 0.5rem 1.25rem;">
        返回藥品搜尋
      </a>
    </div>

    <!-- 3. 載入失敗狀態 (Error) -->
    <div id="state-error" class="card" style="display: none; padding: 2.5rem; text-align: center; color: #991b1b; background-color: #fef2f2; border: 1px solid #fecaca;">
      <span style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;">⚠️</span>
      <h2 style="font-size: 1.35rem; color: #991b1b; margin-bottom: 0.5rem;">資料載入失敗</h2>
      <p style="font-size: 0.95rem; color: #7f1d1d; margin-bottom: 1.5rem;" id="error-message">
        網路連線中斷或伺服器異常，無法讀取藥品資料分片。
      </p>
      <div style="display: flex; justify-content: center; gap: 1rem;">
        <button id="retry-btn" class="btn btn-primary" style="padding: 0.5rem 1.25rem;">
          🔄 重新載入
        </button>
        <a href={withBase('/')} class="btn btn-secondary" style="padding: 0.5rem 1.25rem;">
          返回搜尋首頁
        </a>
      </div>
    </div>

    <!-- 4. 渲染完成容器 (Ready) -->
    <div id="state-ready" style="display: none;"></div>
  </div>

  <style>
    .skeleton-line {
      background: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 37%, #f3f4f6 63%);
      background-size: 400% 100%;
      animation: skeleton-loading 1.4s ease infinite;
      border-radius: 4px;
    }
    @keyframes skeleton-loading {
      0% {
        background-position: 100% 50%;
      }
      100% {
        background-position: 0 50%;
      }
    }
  </style>

  <script>
    import { shardOf, shardPath, DRUG_SHARDS } from '../../lib/shard';
    import { dataUrl } from '../../lib/url';
    import { renderProduct } from '../../lib/render-product';

    const appEl = document.getElementById('drug-app');
    const dataVersion = appEl?.getAttribute('data-version') || undefined;

    const stateLoading = document.getElementById('state-loading');
    const stateNotFound = document.getElementById('state-not-found');
    const stateError = document.getElementById('state-error');
    const stateReady = document.getElementById('state-ready');
    const retryBtn = document.getElementById('retry-btn');

    function showState(state: 'loading' | 'notFound' | 'error' | 'ready') {
      if (stateLoading) stateLoading.style.display = state === 'loading' ? 'flex' : 'none';
      if (stateNotFound) stateNotFound.style.display = state === 'notFound' ? 'block' : 'none';
      if (stateError) stateError.style.display = state === 'error' ? 'block' : 'none';
      if (stateReady) stateReady.style.display = state === 'ready' ? 'block' : 'none';
    }

    function initCompareBtn(productSlug: string) {
      const btn = document.getElementById('detail-compare-btn');
      if (!btn) return;

      function checkInList(): boolean {
        try {
          const raw = localStorage.getItem('vet_drug_compare_list');
          const list = raw ? JSON.parse(raw) : [];
          return Array.isArray(list) && list.includes(productSlug);
        } catch {
          return false;
        }
      }

      function updateBtnState() {
        const inList = checkInList();
        if (inList) {
          btn.textContent = '✓ 已在比較清單';
          btn.classList.remove('btn-secondary');
          btn.classList.add('btn-primary');
        } else {
          btn.textContent = '➕ 加入比較';
          btn.classList.remove('btn-primary');
          btn.classList.add('btn-secondary');
        }
      }

      updateBtnState();

      btn.addEventListener('click', () => {
        try {
          const raw = localStorage.getItem('vet_drug_compare_list');
          let list = raw ? JSON.parse(raw) : [];
          if (!Array.isArray(list)) list = [];

          if (list.includes(productSlug)) {
            list = list.filter((s: string) => s !== productSlug);
          } else {
            if (list.length >= 3) {
              alert('比較清單上限為 3 項產品，請先至比較表移除部分項目。');
              return;
            }
            list.push(productSlug);
          }

          localStorage.setItem('vet_drug_compare_list', JSON.stringify(list));
          updateBtnState();
          window.dispatchEvent(new Event('compare-updated'));
        } catch {
          alert('無法寫入本機儲存空間');
        }
      });
    }

    async function loadProductDetail() {
      showState('loading');

      const params = new URLSearchParams(window.location.search);
      const slug = params.get('id')?.trim();

      if (!slug) {
        showState('notFound');
        return;
      }

      try {
        const shardIndex = shardOf(slug, DRUG_SHARDS);
        const relativePath = shardPath('drug', shardIndex);
        const fetchUrl = dataUrl(relativePath, dataVersion);

        const response = await fetch(fetchUrl);
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        const shardData = await response.json();
        const product = shardData[slug];

        if (!product) {
          showState('notFound');
          return;
        }

        // 動態修改頁面標題
        document.title = `${product.nameZh} (${product.licenseNo}) - 動物用藥資訊`;

        // 渲染產品內容
        if (stateReady) {
          stateReady.innerHTML = renderProduct(product);
          initCompareBtn(product.slug);
        }

        showState('ready');
      } catch (err) {
        console.error('[drug] 載入分片失敗:', err);
        showState('error');
      }
    }

    retryBtn?.addEventListener('click', () => {
      loadProductDetail();
    });

    window.addEventListener('DOMContentLoaded', () => {
      loadProductDetail();
    });
  </script>
</Layout>
